{
  "name": "@braintrust/pi-extension",
  "version": "2.0.0",
  "description": "Braintrust extension for pi. Includes automatic tracing for pi sessions, turns, LLM calls, and tool executions to Braintrust.",
  "keywords": [
    "braintrust",
    "llm",
    "observability",
    "pi",
    "pi-package",
    "tracing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/braintrustdata/braintrust-coding-agent-plugins.git",
    "directory": "src/plugins/pi/content"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare:daemon-client": "node ../../../../scripts/prepare-js-daemon-client.mjs pi",
    "build": "pnpm run prepare:daemon-client && pnpm run sync:version && vp pack",
    "build:prepared": "pnpm run sync:version && vp pack",
    "check": "pnpm run prepare:daemon-client && node scripts/sync-version.mjs --check && vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "prepack": "node scripts/sync-version.mjs",
    "pack": "pnpm run build",
    "publish:dry-run": "pnpm run build && pnpm publish --dry-run --no-git-checks",
    "smoke": "node -e \"import('./dist/index.mjs')\"",
    "sync:version": "node scripts/sync-version.mjs",
    "test": "pnpm run prepare:daemon-client && vitest run",
    "test:watch": "pnpm run prepare:daemon-client && vitest",
    "typecheck": "pnpm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.2",
    "vite-plus": "^0.2.1",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "packageManager": "pnpm@11.21.0",
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  }
}

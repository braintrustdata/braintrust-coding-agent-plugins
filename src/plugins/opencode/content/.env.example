# Braintrust API Key (required)
# Get your API key from https://www.braintrust.dev/app/settings
BRAINTRUST_API_KEY=your-api-key-here

# Enable debug logging (optional, default: false)
BRAINTRUST_DEBUG=false

# Custom Braintrust app URL (optional, default: https://www.braintrust.dev)
# BRAINTRUST_APP_URL=https://www.braintrust.dev

# Custom API URL (optional, will be auto-discovered from login)
# BRAINTRUST_API_URL=https://api.braintrust.dev

# Tracing profile, organization, project, and enablement are configured in
# braintrust.json, not environment variables. Run:
#   bt trace setup opencode --profile work --org my-org --project my-project
# or override for one invocation with:
#   bt trace run --profile work --project my-project opencode

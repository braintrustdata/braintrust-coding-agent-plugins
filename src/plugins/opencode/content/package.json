{
  "name": "@braintrust/trace-opencode",
  "version": "2.1.2",
  "description": "Automatically trace OpenCode conversations to Braintrust. Captures user messages, assistant responses, and tool calls for observability.",
  "keywords": [
    "braintrust",
    "evaluation",
    "llm",
    "observability",
    "opencode",
    "tracing"
  ],
  "license": "MIT",
  "author": "Braintrust",
  "repository": {
    "type": "git",
    "url": "https://github.com/braintrustdata/braintrust-coding-agent-plugins.git",
    "directory": "src/plugins/opencode/content"
  },
  "files": [
    "dist",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./tracing": {
      "types": "./dist/tracing.d.mts",
      "import": "./dist/tracing.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare:daemon-client": "node ../../../../scripts/prepare-js-daemon-client.mjs opencode",
    "build": "pnpm run prepare:daemon-client && vp pack",
    "build:prepared": "vp pack",
    "check": "pnpm run prepare:daemon-client && vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "publish:dry-run": "pnpm run build && pnpm publish --dry-run --no-git-checks",
    "smoke": "node -e \"Promise.all([import('./dist/index.mjs'), import('./dist/tracing.mjs'), import('./dist/server.mjs')])\"",
    "test": "pnpm run prepare:daemon-client && vp test run",
    "test:watch": "pnpm run prepare:daemon-client && vp test watch",
    "typecheck": "pnpm run check"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.34",
    "@opencode-ai/sdk": "^1.18.34",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vite-plus": "^1.4.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.2.25",
    "@opencode-ai/sdk": ">=1.2.25"
  },
  "packageManager": "pnpm@11.21.0"
}

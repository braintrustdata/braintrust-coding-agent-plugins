{
  "braintrust-tracing": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"./bin/antigravity-hook.sh\" PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh \"./bin/antigravity-hook.sh\" PreInvocation",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "sh \"./bin/antigravity-hook.sh\" PostInvocation",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh \"./bin/antigravity-hook.sh\" Stop",
        "timeout": 30
      }
    ]
  }
}
